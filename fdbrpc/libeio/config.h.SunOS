/* config.h for illumos / SmartOS.
 *
 * illumos provides most POSIX facilities libeio needs; the Linux-specific
 * extensions (fallocate, splice, fiemap, readahead) are deliberately absent.
 * sendfile(3EXT) maps to sendfilev() via libeio's __solaris branch in eio.c.
 */

/* Define to 1 if you have the <dlfcn.h> header file. */
#define HAVE_DLFCN_H 1

/* fdatasync(2) is available */
#define HAVE_FDATASYNC 1

/* futimesat(2) is available; libeio prefers futimes but on illumos we fall back
   to the emulation path which uses utime(2). */
/* #undef HAVE_FUTIMES */

/* Define to 1 if you have the <inttypes.h> header file. */
#define HAVE_INTTYPES_H 1

/* fallocate(2) is Linux-specific */
/* #undef HAVE_LINUX_FALLOCATE */
/* #undef HAVE_LINUX_FIEMAP_H */
/* #undef HAVE_LINUX_FS_H */
/* #undef HAVE_LINUX_SPLICE */

/* Define to 1 if you have the <memory.h> header file. */
#define HAVE_MEMORY_H 1

/* posix_fadvise(2) is available */
#define HAVE_POSIX_FADVISE 1

/* posix_madvise(2) is available */
#define HAVE_POSIX_MADVISE 1

/* prctl() is Linux-specific */
/* #undef HAVE_PRCTL_SET_NAME */

/* readahead(2) is Linux-specific */
/* #undef HAVE_READAHEAD */

/* sendfile(3EXT) is available; eio.c __solaris branch uses sendfilev(3EXT) */
#define HAVE_SENDFILE 1

/* Define to 1 if you have the <stdint.h> header file. */
#define HAVE_STDINT_H 1

/* Define to 1 if you have the <stdlib.h> header file. */
#define HAVE_STDLIB_H 1

/* Define to 1 if you have the <strings.h> header file. */
#define HAVE_STRINGS_H 1

/* Define to 1 if you have the <string.h> header file. */
#define HAVE_STRING_H 1

/* sync_file_range(2) is Linux-specific */
/* #undef HAVE_SYNC_FILE_RANGE */

/* sys/prctl.h is Linux-specific */
/* #undef HAVE_SYS_PRCTL_H */

/* Define to 1 if you have the <sys/stat.h> header file. */
#define HAVE_SYS_STAT_H 1

/* syscall(__NR_syncfs) is Linux-specific */
/* #undef HAVE_SYS_SYNCFS */

/* Define to 1 if you have the <sys/syscall.h> header file. */
#define HAVE_SYS_SYSCALL_H 1

/* Define to 1 if you have the <sys/types.h> header file. */
#define HAVE_SYS_TYPES_H 1

/* Define to 1 if you have the <unistd.h> header file. */
#define HAVE_UNISTD_H 1

/* utimes(2) is available on illumos */
#define HAVE_UTIMES 1

/* Define to the sub-directory where libtool stores uninstalled libraries. */
#define LT_OBJDIR ".libs/"

#define PACKAGE "libeio"
#define PACKAGE_BUGREPORT ""
#define PACKAGE_NAME ""
#define PACKAGE_STRING ""
#define PACKAGE_TARNAME ""
#define PACKAGE_URL ""
#define PACKAGE_VERSION ""

#define STDC_HEADERS 1

/* Enable threading extensions on illumos (inherited from Solaris). */
#ifndef _POSIX_PTHREAD_SEMANTICS
#define _POSIX_PTHREAD_SEMANTICS 1
#endif
/* Expose illumos kstat/libproc/etc. extensions that libeio's emulation code
   relies on (O_DIRECT, advanced sendfilev, asynchronous I/O). */
#ifndef __EXTENSIONS__
#define __EXTENSIONS__ 1
#endif

#define VERSION "1.0"
